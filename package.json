{
  "name": "lemonmail",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"wrangler dev\"",
    "build": "vue-tsc -b && vite build && npm run build:worker",
    "build:worker": "wrangler deploy --dry-run --outdir dist-worker",
    "typecheck": "vue-tsc -b --pretty false",
    "deploy": "npm run build && npm run deploy:worker && npm run deploy:pages",
    "deploy:worker": "wrangler deploy",
    "deploy:pages": "wrangler pages deploy dist --project-name lemon-mail --branch main",
    "db:migrate": "wrangler d1 migrations apply lemon-mail --remote",
    "db:migrate:local": "wrangler d1 migrations apply lemon-mail --local"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.3",
    "dompurify": "^3.4.13",
    "hono": "^4.8.5",
    "postal-mime": "^2.7.5",
    "vue": "^3.5.18",
    "vue-i18n": "11.1.9",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@intlify/devtools-types": "^11.4.8",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.1.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^3.0.5",
    "wrangler": "^4.119.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true,
    "sharp@0.33.5": true,
    "sharp@0.35.2": true
  }
}
